From 8f96d642a7b84fdba0b649ef1fecc960ac17ab89 Mon Sep 17 00:00:00 2001
From: Fabiano Tassotti <fabianotassotti@gmail.com>
Date: Sat, 25 Jul 2026 23:55:00 -0300
Subject: [PATCH] wifi: ath11k: add an opt-in low-memory datapath profile

ath11k allocates a 4096-entry primary RX buffer ring for every radio.
Since every entry is backed by an SKB, this ring leaves too little
runtime headroom on systems with 256 MiB of RAM and two radios.

Allow memory-constrained boards to shrink it further through the
qcom,ath11k-low-memory-datapath property, down to 1024 entries.

Rebased on top of 911-ath11k-reduce-dma-buffer-to-save-memeory.patch,
which now shrinks DP_RXDMA_BUF_RING_SIZE to 2048 and the monitor buffer
and destination rings to 128 unconditionally for every board. This
patch's own monitor-ring low-memory variants (originally 256 and 512,
matching the upstream ath12k low-memory profile) are dropped: they
would have been larger than 911's new unconditional default of 128 and
so would have increased memory use for boards opting in. Only the
primary RX buffer ring still benefits from an additional opt-in
reduction, from 911's 2048 default down to 1024.

Keep the existing DP_RXDMA_BUF_RING_SIZE value as the default so
platforms that do not opt in retain identical datapath behavior.

Signed-off-by: Fabiano Tassotti <fabianotassotti@gmail.com>
---
 drivers/net/wireless/ath/ath11k/core.c  | 5 +++++
 drivers/net/wireless/ath/ath11k/dp.h    | 1 +
 drivers/net/wireless/ath/ath11k/dp_rx.c | 5 ++++-
 drivers/net/wireless/ath/ath11k/hw.h    | 1 +
 4 files changed, 11 insertions(+), 1 deletion(-)

--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -2637,6 +2637,11 @@ static int ath11k_init_hw_params(struct

 	ab->hw_params = *hw_params;

+	ab->hw_params.low_memory_datapath =
+		of_property_read_bool(ab->dev->of_node,
+				      "qcom,ath11k-low-memory-datapath");
+	if (ab->hw_params.low_memory_datapath)
+		ath11k_info(ab, "using low-memory datapath profile\n");
 	ret = of_property_read_u32(ab->dev->of_node,
 				   "qcom,ath11k-fw-memory-mode",
 				   &fw_mem_mode);
--- a/drivers/net/wireless/ath/ath11k/dp.h
+++ b/drivers/net/wireless/ath/ath11k/dp.h
@@ -218,6 +218,7 @@ struct ath11k_pdev_dp {
 #define DP_REO_EXCEPTION_RING_SIZE	128
 #define DP_REO_CMD_RING_SIZE		256
 #define DP_REO_STATUS_RING_SIZE		2048
 #define DP_RXDMA_BUF_RING_SIZE		2048
+#define DP_RXDMA_BUF_RING_SIZE_LOW_MEMORY	1024
 #define DP_RXDMA_REFILL_RING_SIZE	2048
 #define DP_RXDMA_ERR_DST_RING_SIZE	1024
 #define DP_RXDMA_MON_STATUS_RING_SIZE	1024
 #define DP_RXDMA_MONITOR_BUF_RING_SIZE	128
 #define DP_RXDMA_MONITOR_DST_RING_SIZE	128
 #define DP_RXDMA_MONITOR_DESC_RING_SIZE	4096

 #define DP_RX_RELEASE_RING_NUM	3
--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -572,10 +572,14 @@ static int ath11k_dp_rx_pdev_srng_alloc(
 	struct dp_srng *srng = NULL;
 	int i;
 	int ret;
+	u32 rx_buf_ring_size = DP_RXDMA_BUF_RING_SIZE;
+
+	if (ab->hw_params.low_memory_datapath)
+		rx_buf_ring_size = DP_RXDMA_BUF_RING_SIZE_LOW_MEMORY;

 	ret = ath11k_dp_srng_setup(ar->ab,
 				   &dp->rx_refill_buf_ring.refill_buf_ring,
 				   HAL_RXDMA_BUF, 0,
-				   dp->mac_id, DP_RXDMA_BUF_RING_SIZE);
+				   dp->mac_id, rx_buf_ring_size);
 	if (ret) {
 		ath11k_warn(ar->ab, "failed to setup rx_refill_buf_ring\n");
--- a/drivers/net/wireless/ath/ath11k/hw.h
+++ b/drivers/net/wireless/ath/ath11k/hw.h
@@ -231,6 +231,7 @@ struct ath11k_hw_params {
 	bool support_dual_stations;
 	bool pdev_suspend;
+	bool low_memory_datapath;
 };

 struct ath11k_hw_ops {
