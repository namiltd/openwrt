index 0000000..7d1e88a
--- /dev/null
+++ b/src/tplink-cloud-sign.cpp
@@ -0,0 +1,801 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * tplink-cloud-sign - sign/build "fw-type:Cloud" images for the
+ * TP-Link/Mercusys NVRAM-manager firmware format (Qualcomm QCA51x/IPQ5018
+ * u-boot-2016 lib/nvrammanager).
+ *
+ * This is TP-Link's own container format, not a third-party one:
+ * nm_fwup.c (handle_fw_cloud / rsaVerifySignByBase64EncodePublicKeyBlob /
+ * rsaVerifyPSSSignByBase64EncodePublicKeyBlob), released by TP-Link/
+ * Mercusys themselves under the GPL. This tool is a clean-room
+ * reimplementation of the SIGNING side of that scheme (the vendor GPL
+ * only ever ships the verification side). It does not use, embed, or
+ * attempt to derive TP-Link/Mercusys's actual private signing key -
+ * every key it touches is one generated with the `genkey` subcommand,
+ * so it can only ever produce an image a bootloader rebuilt with that
+ * same public key (see appsbl's own key tooling) will accept.
+ *
+ * Ported from this project's Python prototype
+ * (scripts/tplink-cloud-sign.py, branch tools/tplink-cloud-signer),
+ * itself reverse-engineered from TP-Link/Mercusys's own released GPL
+ * sources - see nm_fwup.c/rsaVerify.c in the appsbl clean-room project.
+ *
+ * Image layout (from nm_fwup.c's IMAGE_SIZE_* constants, byte-exact):
+ *
+ *   0x0000  u32 BE   declared total image size
+ *   0x0004  16 bytes legacy reserved slot, unread by handle_fw_cloud
+ *   0x0014  ...      "fw-type:Cloud\n" (start of the RSA-signed region)
+ *   0x0110  4 bytes  algorithm marker; byte at +2 (abs 0x0112) == 2
+ *                    selects RSA-2048/PSS/SHA-256, else legacy RSA-1024
+ *   0x0130  0x80/    RSA signature, stored BYTE-REVERSED (nm_fwup.c reads
+ *           0x100    it forwards then reverses in place before use)
+ *   0x1014  ...      tplink2022 item table lives here in real images;
+ *                    this tool just writes --payload starting here
+ *   0x1814           IMAGE_SIZE_MIN - real images' UBI/rootfs payload
+ *                    starts here
+ *
+ * Signature schemes (reimplemented byte-for-byte from rsaVerify.c,
+ * including its non-standard quirks - this is NOT textbook PKCS#1):
+ *
+ *   RSA-1024 (legacy): sig = PKCS1v1.5(SHA1(MD5(signed_region)), d, n).
+ *   SHA-1 of the MD5 digest, not of the payload directly - that is what
+ *   the vendor's own rsa2_verifysig() checks.
+ *
+ *   RSA-2048 (PSS): sig = EMSA-PSS(SHA-256(signed_region), MGF1-SHA256,
+ *   salt) then RSA private-key op, salt fixed at 32 bytes (== hashLen)
+ *   so rsaVerify.c's salt-length-dependent AES side path is never hit.
+ */
+
+#include <openssl/bio.h>
+#include <openssl/evp.h>
+#include <openssl/pem.h>
+#include <openssl/rsa.h>
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <memory>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace {
+
+using Bytes = std::vector<uint8_t>;
+
+// --- nm_fwup.c IMAGE_SIZE_* constants, verbatim -------------------------
+
+constexpr size_t IMAGE_SIZE_LEN = 0x04;
+constexpr size_t IMAGE_SIZE_MD5 = 0x10;
+constexpr size_t IMAGE_SIZE_PRODUCT = 0x1000;
+constexpr size_t IMAGE_SIZE_BASE = IMAGE_SIZE_LEN + IMAGE_SIZE_MD5 + IMAGE_SIZE_PRODUCT; // 0x1014
+constexpr size_t IMAGE_SIZE_MIN = IMAGE_SIZE_BASE + 0x800;                              // 0x1814
+
+constexpr size_t IMAGE_SIZE_FWTYPE = IMAGE_SIZE_LEN + IMAGE_SIZE_MD5; // 0x14
+constexpr size_t IMAGE_SIZE_RSA_SIG = IMAGE_SIZE_FWTYPE + 0x11C;      // 0x130
+constexpr size_t IMAGE_SIZE_RSA_VER = IMAGE_SIZE_RSA_SIG - 0x20;      // 0x110
+constexpr size_t IMAGE_LEN_RSA_SIG = 0x80;
+constexpr size_t IMAGE_LEN_RSA2048_SIG = 0x100;
+
+constexpr std::array<uint8_t, 16> ASN1_WEIRD_STUFF = {
+	0x00, 0x30, 0x21, 0x30, 0x09, 0x06, 0x05, 0x2B,
+	0x0E, 0x03, 0x02, 0x1A, 0x05, 0x00, 0x04, 0x14,
+};
+
+struct RouterEntry {
+	const char *name;
+	const char *status;
+};
+
+constexpr RouterEntry COMPATIBLE_ROUTERS[] = {
+	{"Mercusys MR80X v1", "GPL key confirmed (RSA-1024 + 2048)"},
+	{"Mercusys MR70X v2", "GPL key confirmed (RSA-1024 + 2048)"},
+	{"Mercusys MR90X v1", "GPL key confirmed (RSA-1024 only)"},
+	{"TP-Link Archer AX55 Pro / AX3000 Pro", "GPL key confirmed (RSA-1024 + 2048)"},
+	{"TP-Link Archer AX72 Pro / AX5400 Pro", "GPL key confirmed (RSA-1024 + 2048)"},
+	{"TP-Link Deco X50 / X55", "GPL key confirmed (RSA-1024 only)"},
+	{"Mercusys MR80X v5", "confirmed via binary analysis of real OEM firmware"},
+	{"Mercusys MR3000X (v2.0.0, v5.0.0)", "support-list only, GPL not pulled"},
+	{"Mercusys MR1800X (v2.0.0)", "support-list only, GPL not pulled"},
+	{"Mercusys MR70X (v2.0.0)", "support-list only, GPL not pulled"},
+};
+
+[[noreturn]] void die(const std::string &msg)
+{
+	std::cerr << "tplink-cloud-sign: " << msg << "\n";
+	std::exit(1);
+}
+
+// --- small OpenSSL RAII wrappers ----------------------------------------
+
+struct EvpPkeyDeleter {
+	void operator()(EVP_PKEY *p) const { EVP_PKEY_free(p); }
+};
+using EvpPkeyPtr = std::unique_ptr<EVP_PKEY, EvpPkeyDeleter>;
+
+struct EvpPkeyCtxDeleter {
+	void operator()(EVP_PKEY_CTX *c) const { EVP_PKEY_CTX_free(c); }
+};
+using EvpPkeyCtxPtr = std::unique_ptr<EVP_PKEY_CTX, EvpPkeyCtxDeleter>;
+
+struct BioDeleter {
+	void operator()(BIO *b) const { BIO_free(b); }
+};
+using BioPtr = std::unique_ptr<BIO, BioDeleter>;
+
+struct BnDeleter {
+	void operator()(BIGNUM *b) const { BN_free(b); }
+};
+using BnPtr = std::unique_ptr<BIGNUM, BnDeleter>;
+
+struct RsaDeleter {
+	void operator()(RSA *r) const { RSA_free(r); }
+};
+using RsaPtr = std::unique_ptr<RSA, RsaDeleter>;
+
+// --- file / base64 helpers ------------------------------------------------
+
+Bytes read_file(const std::string &path)
+{
+	std::ifstream f(path, std::ios::binary);
+	if (!f)
+		die("cannot open " + path);
+	return Bytes((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+}
+
+void write_file(const std::string &path, const Bytes &data)
+{
+	std::ofstream f(path, std::ios::binary);
+	if (!f)
+		die("cannot create " + path);
+	f.write(reinterpret_cast<const char *>(data.data()), static_cast<std::streamsize>(data.size()));
+}
+
+std::string base64_encode(const Bytes &data)
+{
+	BioPtr b64(BIO_new(BIO_f_base64()));
+	BIO *mem = BIO_new(BIO_s_mem());
+	BIO_set_flags(b64.get(), BIO_FLAGS_BASE64_NO_NL);
+	BIO_push(b64.get(), mem);
+	BIO_write(b64.get(), data.data(), static_cast<int>(data.size()));
+	BIO_flush(b64.get());
+	char *ptr = nullptr;
+	long len = BIO_get_mem_data(mem, &ptr);
+	return std::string(ptr, static_cast<size_t>(len));
+}
+
+Bytes base64_decode(const std::string &encoded_in)
+{
+	std::string encoded;
+	encoded.reserve(encoded_in.size());
+	for (char c : encoded_in)
+		if (!std::isspace(static_cast<unsigned char>(c)))
+			encoded.push_back(c);
+
+	Bytes out(encoded.size());
+	BioPtr b64(BIO_new(BIO_f_base64()));
+	BIO *mem = BIO_new_mem_buf(encoded.data(), static_cast<int>(encoded.size()));
+	BIO_set_flags(b64.get(), BIO_FLAGS_BASE64_NO_NL);
+	BIO_push(b64.get(), mem);
+	int n = BIO_read(b64.get(), out.data(), static_cast<int>(out.size()));
+	BIO_free(mem);
+	if (n <= 0)
+		die("invalid base64 data");
+	out.resize(static_cast<size_t>(n));
+	return out;
+}
+
+Bytes hex_decode(const std::string &hex)
+{
+	if (hex.size() % 2 != 0)
+		die("odd-length hex string");
+	Bytes out(hex.size() / 2);
+	for (size_t i = 0; i < out.size(); i++) {
+		unsigned v;
+		if (sscanf(hex.c_str() + 2 * i, "%2x", &v) != 1)
+			die("invalid hex string");
+		out[i] = static_cast<uint8_t>(v);
+	}
+	return out;
+}
+
+Bytes big_endian(uint32_t v)
+{
+	return {static_cast<uint8_t>(v >> 24), static_cast<uint8_t>(v >> 16),
+		static_cast<uint8_t>(v >> 8), static_cast<uint8_t>(v)};
+}
+
+Bytes little_endian32(uint32_t v)
+{
+	return {static_cast<uint8_t>(v), static_cast<uint8_t>(v >> 8),
+		static_cast<uint8_t>(v >> 16), static_cast<uint8_t>(v >> 24)};
+}
+
+// --- digests ---------------------------------------------------------------
+
+Bytes digest(const EVP_MD *md, const Bytes &data)
+{
+	Bytes out(EVP_MD_size(md));
+	unsigned int len = 0;
+	EVP_MD_CTX *ctx = EVP_MD_CTX_new();
+	if (!ctx || EVP_DigestInit_ex(ctx, md, nullptr) != 1 ||
+	    EVP_DigestUpdate(ctx, data.data(), data.size()) != 1 ||
+	    EVP_DigestFinal_ex(ctx, out.data(), &len) != 1) {
+		EVP_MD_CTX_free(ctx);
+		die("digest computation failed");
+	}
+	EVP_MD_CTX_free(ctx);
+	out.resize(len);
+	return out;
+}
+
+Bytes sha256(const Bytes &data) { return digest(EVP_sha256(), data); }
+Bytes sha1(const Bytes &data) { return digest(EVP_sha1(), data); }
+Bytes md5(const Bytes &data) { return digest(EVP_md5(), data); }
+
+Bytes mgf1_sha256(const Bytes &seed, size_t mask_len)
+{
+	Bytes out;
+	out.reserve(mask_len + 32);
+	uint32_t counter = 0;
+	while (out.size() < mask_len) {
+		Bytes input = seed;
+		Bytes ctr = big_endian(counter);
+		input.insert(input.end(), ctr.begin(), ctr.end());
+		Bytes h = sha256(input);
+		out.insert(out.end(), h.begin(), h.end());
+		counter++;
+	}
+	out.resize(mask_len);
+	return out;
+}
+
+// --- MS PUBLICKEYBLOB / RSA1 codec (matches tplink-cloud-sign.py) --------
+// bType=6 (PUBLICKEYBLOB), bVersion=2, reserved=0, aiKeyAlg hardcoded to
+// CALG_RSA_KEYX (0xa400) regardless of key size - this matches the
+// Python prototype exactly, including that quirk; appsbl's own
+// scripts/appsbl-keytool.py uses a per-key alg_id instead, so a blob
+// from this tool is not a drop-in replacement for one from that script.
+
+std::string build_public_blob(const Bytes &n_be, uint32_t e, int bits)
+{
+	Bytes blob;
+	blob.insert(blob.end(), {0x06, 0x02, 0x00, 0x00});
+	Bytes alg = little_endian32(0x0000a400);
+	blob.insert(blob.end(), alg.begin(), alg.end());
+	blob.insert(blob.end(), {'R', 'S', 'A', '1'});
+	Bytes bits_le = little_endian32(static_cast<uint32_t>(bits));
+	blob.insert(blob.end(), bits_le.begin(), bits_le.end());
+	Bytes e_le = little_endian32(e);
+	blob.insert(blob.end(), e_le.begin(), e_le.end());
+	// modulus stored little-endian; n_be arrives big-endian from BIGNUM
+	Bytes n_le(n_be.rbegin(), n_be.rend());
+	if (n_le.size() != static_cast<size_t>(bits / 8))
+		die("unexpected modulus size while building public blob");
+	blob.insert(blob.end(), n_le.begin(), n_le.end());
+	return base64_encode(blob);
+}
+
+struct ParsedBlob {
+	BnPtr n;
+	uint32_t e;
+	int bits;
+};
+
+ParsedBlob parse_public_blob(const std::string &b64)
+{
+	Bytes raw = base64_decode(b64);
+	if (raw.size() < 20 || std::memcmp(raw.data() + 8, "RSA1", 4) != 0)
+		die("not a PUBLICKEYBLOB/RSA1 blob");
+	uint32_t bits = static_cast<uint32_t>(raw[12]) | (static_cast<uint32_t>(raw[13]) << 8) |
+			(static_cast<uint32_t>(raw[14]) << 16) | (static_cast<uint32_t>(raw[15]) << 24);
+	uint32_t e = static_cast<uint32_t>(raw[16]) | (static_cast<uint32_t>(raw[17]) << 8) |
+		     (static_cast<uint32_t>(raw[18]) << 16) | (static_cast<uint32_t>(raw[19]) << 24);
+	size_t nbytes = bits / 8;
+	if (raw.size() < 20 + nbytes)
+		die("truncated PUBLICKEYBLOB");
+	Bytes n_le(raw.begin() + 20, raw.begin() + 20 + nbytes);
+	Bytes n_be(n_le.rbegin(), n_le.rend());
+	BnPtr n(BN_bin2bn(n_be.data(), static_cast<int>(n_be.size()), nullptr));
+	if (!n)
+		die("failed to parse modulus");
+	return {std::move(n), e, static_cast<int>(bits)};
+}
+
+// --- key I/O ---------------------------------------------------------------
+
+EvpPkeyPtr generate_keypair(int bits)
+{
+	// Classic RSA_generate_key_ex()/EVP_PKEY_assign_RSA() rather than the
+	// OpenSSL 3.0 provider API (EVP_PKEY_CTX_new_from_name() etc.) - this
+	// tool also builds against LibreSSL (tools/firmware-utils's HostBuild
+	// stages tools/libressl, not a real OpenSSL 3.x, for host tools),
+	// which never adopted the provider model at all.
+	RsaPtr rsa(RSA_new());
+	BnPtr e(BN_new());
+	if (!rsa || !e || !BN_set_word(e.get(), RSA_F4) ||
+	    RSA_generate_key_ex(rsa.get(), bits, e.get(), nullptr) != 1)
+		die("RSA key generation failed");
+	EvpPkeyPtr pkey(EVP_PKEY_new());
+	if (!pkey || EVP_PKEY_assign_RSA(pkey.get(), rsa.get()) != 1)
+		die("RSA key generation failed");
+	rsa.release(); // ownership transferred to pkey on success
+	return pkey;
+}
+
+void write_private_pem(const std::string &path, EVP_PKEY *pkey)
+{
+	BioPtr bio(BIO_new_file(path.c_str(), "w"));
+	if (!bio || PEM_write_bio_PrivateKey_traditional(bio.get(), pkey, nullptr, nullptr, 0, nullptr, nullptr) != 1)
+		die("failed to write private key to " + path);
+}
+
+EvpPkeyPtr load_private_pem_from_string(const std::string &pem, const std::string &what)
+{
+	BioPtr bio(BIO_new_mem_buf(pem.data(), static_cast<int>(pem.size())));
+	if (!bio)
+		die("cannot read " + what);
+	EVP_PKEY *pkey = PEM_read_bio_PrivateKey(bio.get(), nullptr, nullptr, nullptr);
+	if (!pkey)
+		die("failed to parse private key in " + what);
+	return EvpPkeyPtr(pkey);
+}
+
+EvpPkeyPtr load_private_pem(const std::string &path)
+{
+	BioPtr bio(BIO_new_file(path.c_str(), "r"));
+	if (!bio)
+		die("cannot open " + path);
+	EVP_PKEY *pkey = PEM_read_bio_PrivateKey(bio.get(), nullptr, nullptr, nullptr);
+	if (!pkey)
+		die("failed to parse private key in " + path);
+	return EvpPkeyPtr(pkey);
+}
+
+// Checks a loaded key's actual RSA modulus size matches what the caller
+// expects (--alg), whether it came from a file or from the compiled-in
+// default - a substituted default of the wrong size is a build-time
+// misconfiguration, not something to silently truncate/pad around.
+void check_key_bits(EVP_PKEY *pkey, int expected_bits, const std::string &what)
+{
+	int actual = EVP_PKEY_bits(pkey);
+	if (actual != expected_bits)
+		die(what + " is " + std::to_string(actual) + "-bit, expected exactly " +
+		    std::to_string(expected_bits) + " for --alg " + std::to_string(expected_bits));
+}
+
+Bytes bn_param_be(EVP_PKEY *pkey, const char *name)
+{
+	RsaPtr rsa(EVP_PKEY_get1_RSA(pkey));
+	if (!rsa)
+		die(std::string("failed to read RSA parameter ") + name);
+	const BIGNUM *n = nullptr, *e = nullptr, *d = nullptr;
+	RSA_get0_key(rsa.get(), &n, &e, &d);
+	const BIGNUM *bn = (std::strcmp(name, "n") == 0) ? n : e;
+	Bytes out(static_cast<size_t>(BN_num_bytes(bn)));
+	BN_bn2bin(bn, out.data());
+	return out;
+}
+
+uint32_t bn_param_u32(EVP_PKEY *pkey, const char *name)
+{
+	Bytes be = bn_param_be(pkey, name);
+	uint32_t v = 0;
+	for (uint8_t b : be)
+		v = (v << 8) | b;
+	return v;
+}
+
+// --- raw RSA private/public operations (RSA_NO_PADDING) --------------------
+// The vendor's padding (both schemes) is applied by hand below, matching
+// rsaVerify.c exactly; these just perform the modular exponentiation.
+
+Bytes rsa_private_raw(EVP_PKEY *pkey, const Bytes &em)
+{
+	EvpPkeyCtxPtr ctx(EVP_PKEY_CTX_new(pkey, nullptr));
+	if (!ctx || EVP_PKEY_sign_init(ctx.get()) <= 0 ||
+	    EVP_PKEY_CTX_set_rsa_padding(ctx.get(), RSA_NO_PADDING) <= 0)
+		die("failed to initialize raw RSA private operation");
+	size_t outlen = 0;
+	if (EVP_PKEY_sign(ctx.get(), nullptr, &outlen, em.data(), em.size()) <= 0)
+		die("RSA private operation sizing failed");
+	Bytes out(outlen);
+	if (EVP_PKEY_sign(ctx.get(), out.data(), &outlen, em.data(), em.size()) <= 0)
+		die("RSA private operation failed");
+	out.resize(outlen);
+	return out;
+}
+
+Bytes rsa_public_recover_raw(const BIGNUM *n, uint32_t e, const Bytes &sig)
+{
+	// Classic RSA_set0_key()/EVP_PKEY_assign_RSA() rather than the OpenSSL
+	// 3.0 provider API (EVP_PKEY_fromdata() and friends) - see the same
+	// note in generate_keypair().
+	RsaPtr rsa(RSA_new());
+	BIGNUM *n_dup = BN_dup(n);
+	BIGNUM *e_bn = BN_new();
+	if (!rsa || !n_dup || !e_bn || !BN_set_word(e_bn, e) ||
+	    RSA_set0_key(rsa.get(), n_dup, e_bn, nullptr) != 1)
+		die("failed to build public key for verification");
+	// RSA_set0_key() took ownership of n_dup/e_bn on success.
+
+	EvpPkeyPtr pkey(EVP_PKEY_new());
+	if (!pkey || EVP_PKEY_assign_RSA(pkey.get(), rsa.get()) != 1)
+		die("failed to build public key for verification");
+	rsa.release(); // ownership transferred to pkey on success
+
+	EvpPkeyCtxPtr ctx(EVP_PKEY_CTX_new(pkey.get(), nullptr));
+	if (!ctx || EVP_PKEY_verify_recover_init(ctx.get()) <= 0 ||
+	    EVP_PKEY_CTX_set_rsa_padding(ctx.get(), RSA_NO_PADDING) <= 0)
+		die("failed to initialize raw RSA public operation");
+	size_t outlen = 0;
+	if (EVP_PKEY_verify_recover(ctx.get(), nullptr, &outlen, sig.data(), sig.size()) <= 0)
+		die("RSA public operation sizing failed");
+	Bytes out(outlen);
+	if (EVP_PKEY_verify_recover(ctx.get(), out.data(), &outlen, sig.data(), sig.size()) <= 0)
+		die("RSA public operation failed (bad signature or key)");
+	out.resize(outlen);
+	return out;
+}
+
+// --- signing primitives, matching rsaVerify.c exactly -----------------------
+
+Bytes sign_rsa1024_legacy(const Bytes &signed_region, EVP_PKEY *pkey)
+{
+	constexpr size_t nbytes = 128; // 1024 bits
+	Bytes md5_dig = md5(signed_region);
+	Bytes hash20 = sha1(md5_dig);
+
+	size_t pad_ff_len = nbytes - 1 - 1 - ASN1_WEIRD_STUFF.size() - hash20.size();
+	Bytes em;
+	em.reserve(nbytes);
+	em.insert(em.end(), {0x00, 0x01});
+	em.insert(em.end(), pad_ff_len, 0xff);
+	em.insert(em.end(), ASN1_WEIRD_STUFF.begin(), ASN1_WEIRD_STUFF.end());
+	em.insert(em.end(), hash20.begin(), hash20.end());
+	if (em.size() != nbytes)
+		die("internal padding error building RSA-1024 EM");
+
+	Bytes sig = rsa_private_raw(pkey, em);
+	if (sig.size() != nbytes)
+		die("unexpected RSA-1024 signature size");
+	std::reverse(sig.begin(), sig.end()); // wire format is byte-reversed
+	return sig;
+}
+
+Bytes sign_rsa2048_pss(const Bytes &signed_region, EVP_PKEY *pkey, const Bytes &salt)
+{
+	constexpr size_t nbytes = 256; // 2048 bits
+	constexpr size_t hash_len = 32;
+	size_t slen = salt.size();
+	if (slen > 32)
+		die("PSS salt must be <=32 bytes to avoid rsaVerify.c's AES side effect");
+
+	Bytes mhash = sha256(signed_region);
+	Bytes mprime;
+	mprime.insert(mprime.end(), 8, 0x00);
+	mprime.insert(mprime.end(), mhash.begin(), mhash.end());
+	mprime.insert(mprime.end(), salt.begin(), salt.end());
+	Bytes h = sha256(mprime);
+
+	size_t db_len = nbytes - 1 - hash_len; // 223
+	size_t ps_len = db_len - slen - 1;
+	Bytes db;
+	db.insert(db.end(), ps_len, 0x00);
+	db.push_back(0x01);
+	db.insert(db.end(), salt.begin(), salt.end());
+
+	Bytes mask = mgf1_sha256(h, db_len);
+	Bytes masked_db(db_len);
+	for (size_t i = 0; i < db_len; i++)
+		masked_db[i] = db[i] ^ mask[i];
+	masked_db[0] &= static_cast<uint8_t>(~0x80); // matches verify side's mask[0] &= ~0x80
+
+	Bytes em;
+	em.reserve(nbytes);
+	em.insert(em.end(), masked_db.begin(), masked_db.end());
+	em.insert(em.end(), h.begin(), h.end());
+	em.push_back(0xbc);
+	if (em.size() != nbytes)
+		die("internal padding error building RSA-2048 PSS EM");
+
+	Bytes sig = rsa_private_raw(pkey, em);
+	if (sig.size() != nbytes)
+		die("unexpected RSA-2048 signature size");
+	std::reverse(sig.begin(), sig.end()); // wire format is byte-reversed
+	return sig;
+}
+
+bool verify_rsa1024_legacy(const Bytes &signed_region, const Bytes &sig_wire, const BIGNUM *n, uint32_t e)
+{
+	constexpr size_t nbytes = 128;
+	Bytes sig(sig_wire.rbegin(), sig_wire.rend());
+	Bytes em = rsa_public_recover_raw(n, e, sig);
+	if (em.size() != nbytes)
+		return false;
+
+	Bytes md5_dig = md5(signed_region);
+	Bytes hash20 = sha1(md5_dig);
+	size_t pad_ff_len = nbytes - 1 - 1 - ASN1_WEIRD_STUFF.size() - hash20.size();
+	Bytes expected;
+	expected.insert(expected.end(), {0x00, 0x01});
+	expected.insert(expected.end(), pad_ff_len, 0xff);
+	expected.insert(expected.end(), ASN1_WEIRD_STUFF.begin(), ASN1_WEIRD_STUFF.end());
+	expected.insert(expected.end(), hash20.begin(), hash20.end());
+	return em == expected;
+}
+
+bool verify_rsa2048_pss(const Bytes &signed_region, const Bytes &sig_wire, const BIGNUM *n, uint32_t e)
+{
+	constexpr size_t nbytes = 256;
+	constexpr size_t hash_len = 32;
+	Bytes sig(sig_wire.rbegin(), sig_wire.rend());
+	Bytes em = rsa_public_recover_raw(n, e, sig);
+	if (em.size() != nbytes || em.back() != 0xbc)
+		return false;
+
+	size_t db_len = nbytes - 1 - hash_len;
+	Bytes masked_db(em.begin(), em.begin() + static_cast<long>(db_len));
+	Bytes h(em.begin() + static_cast<long>(db_len), em.end() - 1);
+	Bytes mask = mgf1_sha256(h, db_len);
+	Bytes db(db_len);
+	for (size_t i = 0; i < db_len; i++)
+		db[i] = masked_db[i] ^ mask[i];
+	db[0] &= static_cast<uint8_t>(~0x80);
+
+	auto sep_it = std::find(db.begin(), db.end(), static_cast<uint8_t>(1));
+	if (sep_it == db.end())
+		return false;
+	if (std::any_of(db.begin(), sep_it, [](uint8_t b) { return b != 0; }))
+		return false;
+	Bytes salt(sep_it + 1, db.end());
+
+	Bytes mhash = sha256(signed_region);
+	Bytes mprime;
+	mprime.insert(mprime.end(), 8, 0x00);
+	mprime.insert(mprime.end(), mhash.begin(), mhash.end());
+	mprime.insert(mprime.end(), salt.begin(), salt.end());
+	return sha256(mprime) == h;
+}
+
+// --- container construction -------------------------------------------------
+
+Bytes build_and_sign(const Bytes &payload, int alg, EVP_PKEY *pkey,
+		      const std::string &product_name, const std::string &product_ver,
+		      const std::string &special_id, const Bytes &salt)
+{
+	size_t total_size = IMAGE_SIZE_BASE + std::max(payload.size(), IMAGE_SIZE_MIN - IMAGE_SIZE_BASE);
+
+	Bytes header(IMAGE_SIZE_BASE, 0x00);
+	Bytes size_be = big_endian(static_cast<uint32_t>(total_size));
+	std::copy(size_be.begin(), size_be.end(), header.begin());
+	// header[4:0x14] left zero (legacy reserved slot, unread by handle_fw_cloud)
+
+	Bytes product(IMAGE_SIZE_PRODUCT, 0x00); // region [0x14, 0x1014)
+	{
+		const char marker[] = "fw-type:Cloud\n";
+		std::memcpy(product.data(), marker, sizeof(marker) - 1);
+	}
+	size_t rel_rsa_ver = IMAGE_SIZE_RSA_VER - IMAGE_SIZE_FWTYPE; // 0xfc
+	product[rel_rsa_ver + 0] = 0;
+	product[rel_rsa_ver + 1] = 0;
+	product[rel_rsa_ver + 2] = (alg == 2048) ? 2 : 0;
+	product[rel_rsa_ver + 3] = 0;
+
+	std::ostringstream info;
+	info << "product_name:" << product_name << ",product_ver:" << product_ver
+	     << ",special_id:" << special_id;
+	std::string info_str = info.str();
+	constexpr size_t rel_info = 0x400; // arbitrary slot clear of header/sig
+	if (rel_info + info_str.size() > product.size())
+		die("product info string too long");
+	std::memcpy(product.data() + rel_info, info_str.data(), info_str.size());
+
+	std::copy(product.begin(), product.end(), header.begin() + static_cast<long>(IMAGE_SIZE_FWTYPE));
+
+	size_t siglen = (alg == 2048) ? IMAGE_LEN_RSA2048_SIG : IMAGE_LEN_RSA_SIG;
+	Bytes image = header;
+	image.insert(image.end(), payload.begin(), payload.end());
+	image.insert(image.end(), total_size - IMAGE_SIZE_BASE - payload.size(), 0x00);
+	if (image.size() != total_size)
+		die("internal size mismatch building image");
+
+	Bytes buf = image;
+	std::fill(buf.begin() + static_cast<long>(IMAGE_SIZE_RSA_SIG),
+		  buf.begin() + static_cast<long>(IMAGE_SIZE_RSA_SIG + siglen), 0x00);
+	Bytes signed_region(buf.begin() + static_cast<long>(IMAGE_SIZE_FWTYPE), buf.end());
+
+	Bytes sig = (alg == 2048) ? sign_rsa2048_pss(signed_region, pkey, salt)
+				  : sign_rsa1024_legacy(signed_region, pkey);
+
+	std::copy(sig.begin(), sig.end(), buf.begin() + static_cast<long>(IMAGE_SIZE_RSA_SIG));
+	return buf;
+}
+
+// --- CLI ---------------------------------------------------------------------
+
+std::optional<std::string> arg_value(const std::vector<std::string> &args, const std::string &flag)
+{
+	for (size_t i = 0; i + 1 < args.size(); i++)
+		if (args[i] == flag)
+			return args[i + 1];
+	return std::nullopt;
+}
+
+std::string require_arg(const std::vector<std::string> &args, const std::string &flag)
+{
+	auto v = arg_value(args, flag);
+	if (!v)
+		die("missing required argument " + flag);
+	return *v;
+}
+
+bool has_flag(const std::vector<std::string> &args, const std::string &flag)
+{
+	return std::find(args.begin(), args.end(), flag) != args.end();
+}
+
+std::string read_stdin(void)
+{
+	std::ostringstream ss;
+	ss << std::cin.rdbuf();
+	return ss.str();
+}
+
+void usage()
+{
+	std::cerr <<
+		"usage: tplink-cloud-sign <command> [options]\n"
+		"\n"
+		"commands:\n"
+		"  genkey --bits <1024|2048> --out-private <priv.pem> --out-public <pub.blob.b64>\n"
+		"  sign --alg <1024|2048> [--private-key <priv.pem>|--private-key-stdin]\n"
+		"       --payload <file> --out <signed.bin> [--product-name NAME]\n"
+		"       [--product-ver VER] [--special-id ID] [--salt-hex HEX]\n"
+		"  verify --alg <1024|2048> --public-key <pub.blob.b64> --in <signed.bin>\n"
+		"  list-routers\n"
+		"\n"
+		"Only ever signs with a key generated by `genkey` - never TP-Link's\n"
+		"real signing key, which this tool does not have and cannot derive.\n"
+		"\n"
+		"Exactly one of --private-key/--private-key-stdin is required for\n"
+		"`sign`. --private-key-stdin reads a PEM private key from stdin\n"
+		"instead of a file - for passing key material straight from a\n"
+		"Makefile variable without ever writing it to disk or exposing it\n"
+		"in argv/`ps`.\n";
+}
+
+int cmd_genkey(const std::vector<std::string> &args)
+{
+	int bits = std::stoi(require_arg(args, "--bits"));
+	if (bits != 1024 && bits != 2048)
+		die("--bits must be 1024 or 2048");
+	std::string out_private = require_arg(args, "--out-private");
+	std::string out_public = require_arg(args, "--out-public");
+
+	EvpPkeyPtr pkey = generate_keypair(bits);
+	write_private_pem(out_private, pkey.get());
+
+	Bytes n_be = bn_param_be(pkey.get(), "n");
+	uint32_t e = bn_param_u32(pkey.get(), "e");
+	std::string blob = build_public_blob(n_be, e, bits);
+	write_file(out_public, Bytes(blob.begin(), blob.end()));
+	{
+		std::ofstream f(out_public, std::ios::app);
+		f << "\n";
+	}
+
+	std::cout << "wrote " << bits << "-bit test keypair:\n"
+		  << "  private: " << out_private << "\n"
+		  << "  public blob: " << out_public << "\n"
+		  << "This is a self-generated TEST key, not TP-Link/Mercusys's real "
+		     "signing key. Only useful against an appsbl you have rebuilt "
+		     "with this public blob swapped in for l_rsaPubKey/l_rsa2048PubKey.\n";
+	return 0;
+}
+
+int cmd_sign(const std::vector<std::string> &args)
+{
+	int alg = std::stoi(require_arg(args, "--alg"));
+	if (alg != 1024 && alg != 2048)
+		die("--alg must be 1024 or 2048");
+	auto private_key_path = arg_value(args, "--private-key");
+	bool private_key_stdin = has_flag(args, "--private-key-stdin");
+	if (private_key_path && private_key_stdin)
+		die("--private-key and --private-key-stdin are mutually exclusive");
+	std::string payload_path = require_arg(args, "--payload");
+	std::string out_path = require_arg(args, "--out");
+	std::string product_name = arg_value(args, "--product-name").value_or("MR80X");
+	std::string product_ver = arg_value(args, "--product-ver").value_or("5.0.0");
+	std::string special_id = arg_value(args, "--special-id").value_or("00000000");
+	auto salt_hex = arg_value(args, "--salt-hex");
+
+	if (!private_key_path && !private_key_stdin)
+		die("--private-key or --private-key-stdin is required");
+
+	EvpPkeyPtr pkey;
+	std::string key_source;
+	if (private_key_path) {
+		pkey = load_private_pem(*private_key_path);
+		key_source = *private_key_path;
+	} else {
+		std::string pem = read_stdin();
+		pkey = load_private_pem_from_string(pem, "key read from stdin");
+		key_source = "key read from stdin";
+	}
+	check_key_bits(pkey.get(), alg, key_source);
+	Bytes payload = read_file(payload_path);
+	Bytes salt = salt_hex ? hex_decode(*salt_hex) : Bytes(32, 0x00);
+
+	Bytes image = build_and_sign(payload, alg, pkey.get(), product_name, product_ver, special_id, salt);
+	write_file(out_path, image);
+
+	std::cout << "wrote " << image.size() << " bytes to " << out_path << " (alg=RSA-" << alg
+		  << ", product=" << product_name << "/" << product_ver << "/" << special_id << ")\n";
+	return 0;
+}
+
+int cmd_verify(const std::vector<std::string> &args)
+{
+	int alg = std::stoi(require_arg(args, "--alg"));
+	if (alg != 1024 && alg != 2048)
+		die("--alg must be 1024 or 2048");
+	std::string public_key_path = require_arg(args, "--public-key");
+	std::string in_path = require_arg(args, "--in");
+
+	Bytes blob_text = read_file(public_key_path);
+	std::string blob_str(blob_text.begin(), blob_text.end());
+	ParsedBlob parsed = parse_public_blob(blob_str);
+
+	Bytes image = read_file(in_path);
+	size_t siglen = (alg == 2048) ? IMAGE_LEN_RSA2048_SIG : IMAGE_LEN_RSA_SIG;
+	Bytes buf = image;
+	Bytes sig(buf.begin() + static_cast<long>(IMAGE_SIZE_RSA_SIG),
+		  buf.begin() + static_cast<long>(IMAGE_SIZE_RSA_SIG + siglen));
+	std::fill(buf.begin() + static_cast<long>(IMAGE_SIZE_RSA_SIG),
+		  buf.begin() + static_cast<long>(IMAGE_SIZE_RSA_SIG + siglen), 0x00);
+	Bytes signed_region(buf.begin() + static_cast<long>(IMAGE_SIZE_FWTYPE), buf.end());
+
+	bool ok = (alg == 2048) ? verify_rsa2048_pss(signed_region, sig, parsed.n.get(), parsed.e)
+				: verify_rsa1024_legacy(signed_region, sig, parsed.n.get(), parsed.e);
+
+	std::cout << (ok ? "VALID" : "INVALID") << "\n";
+	return ok ? 0 : 1;
+}
+
+int cmd_list_routers()
+{
+	for (const auto &r : COMPATIBLE_ROUTERS)
+		std::cout << std::left << std::setw(42) << r.name << " " << r.status << "\n";
+	return 0;
+}
+
+} // namespace
+
+int main(int argc, char **argv)
+{
+	if (argc < 2) {
+		usage();
+		return 1;
+	}
+	std::string cmd = argv[1];
+	std::vector<std::string> args(argv + 2, argv + argc);
+
+	if (cmd == "genkey")
+		return cmd_genkey(args);
+	if (cmd == "sign")
+		return cmd_sign(args);
+	if (cmd == "verify")
+		return cmd_verify(args);
+	if (cmd == "list-routers")
+		return cmd_list_routers();
+
+	usage();
+	return 1;
+}
