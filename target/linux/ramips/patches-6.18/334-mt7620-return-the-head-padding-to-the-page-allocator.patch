From 569a50731333936f49301266edc09ba325f09c9f Mon Sep 17 00:00:00 2001
From: Mieczyslaw Nalewaj <namiltd@yahoo.com>
Date: Sat, 14 Nov 2026 11:31:20 +0000
Subject: [PATCH] MIPS: ralink: mt7620: return the head padding to the
 page allocator

The padding added by the previous patch is reserved until late_initcall,
then handed to the page allocator as ordinary data pages. Code is kept
out of it by the execmem guard.

On MIPS32r2 trap_init() allocates the exception vectors with
memblock_phys_alloc(), so the first page is normally not needed for them
either. Keep it only if ebase actually points into the padding.

Signed-off-by: Mieczyslaw Nalewaj <namiltd@yahoo.com>
---
 arch/mips/ralink/mt7620.c | 36 ++++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

--- a/arch/mips/ralink/mt7620.c
+++ b/arch/mips/ralink/mt7620.c
@@ -11,10 +11,13 @@
 #include <linux/kernel.h>
 #include <linux/init.h>
 #include <linux/bug.h>
+#include <linux/mm.h>
 #include <linux/slab.h>
 #include <linux/sys_soc.h>
 
 #include <asm/mipsregs.h>
+#include <asm/sections.h>
+#include <asm/setup.h>
 #include <asm/mach-ralink/ralink_regs.h>
 #include <asm/mach-ralink/mt7620.h>
 
@@ -266,3 +269,36 @@ void __init prom_soc_init(struct ralink_
 
 	soc_info_ptr = soc_info;
 }
+
+#ifndef CONFIG_NO_EXCEPT_FILL
+
+/*
+ * head.S keeps the first 32 KiB of the image free of code (EPC erratum).
+ * Return the padding to the page allocator once booting is done. The pages
+ * then hold data only; code is kept out of them by the execmem guard in
+ * alloc_phys().
+ *
+ * On MIPS32r2 the exception vectors are allocated by trap_init() outside
+ * the image, so the first page is freed too. Keep it only if ebase points
+ * into the padding.
+ */
+
+static int __init mt7620_free_head_padding(void)
+{
+	unsigned long start = (unsigned long)_text;
+	unsigned long end   = (unsigned long)_stext;
+	unsigned long freed;
+
+	/* Exception vectors inside the padding? Then keep the first page. */
+	if (ebase >= start && ebase < end)
+		start += PAGE_SIZE;
+
+	freed = free_reserved_area((void *)start, (void *)end, -1, NULL);
+
+	pr_info("MT7620: ebase=%lx, freed %lu KiB of head padding (%lx-%lx)\n",
+		ebase, freed << (PAGE_SHIFT - 10), start, end);
+
+	return 0;
+}
+late_initcall(mt7620_free_head_padding);
+#endif
