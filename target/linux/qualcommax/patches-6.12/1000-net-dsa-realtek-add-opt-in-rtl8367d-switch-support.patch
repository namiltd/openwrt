 int rtl8365mb_l2_add_mc(struct realtek_priv *priv, int port,
 			const unsigned char mac_addr[static ETH_ALEN],
diff --git a/drivers/net/dsa/realtek/rtl8365mb_main.c b/drivers/net/dsa/realtek/rtl8365mb_main.c
index 757e962..6e670b3 100644
--- a/drivers/net/dsa/realtek/rtl8365mb_main.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_main.c
@@ -91,12 +91,15 @@
  */
 
 #include <linux/bitfield.h>
+#include <linux/dsa/8021q.h>
 #include <linux/bitops.h>
 #include <linux/interrupt.h>
 #include <linux/irqdomain.h>
 #include <linux/mutex.h>
 #include <linux/of_irq.h>
+#include <linux/property.h>
 #include <linux/regmap.h>
+#include <linux/rtnetlink.h>
 #include <linux/if_bridge.h>
 #include <linux/if_vlan.h>
 
@@ -242,6 +245,41 @@
 #define RTL8365MB_PORT_SPEED_10M	0
 #define RTL8365MB_PORT_SPEED_100M	1
 #define RTL8365MB_PORT_SPEED_1000M	2
+#define RTL8365MB_PORT_SPEED_2500M	3
+
+#define RTL8367S_VB_CHIP_ID				0x6642
+#define RTL8367S_VB_CHIP_VER				0x0010
+#define RTL8367S_VB_EXT_PORT0				6
+
+static bool rtl8367s_8021q_cpu_aware;
+module_param_named(cpu_aware, rtl8367s_8021q_cpu_aware, bool, 0644);
+MODULE_PARM_DESC(cpu_aware, "Keep EXT0 in the RTL8367D CPU-aware port mask");
+
+static bool rtl8367s_8021q_transparent;
+module_param_named(transparent, rtl8367s_8021q_transparent, bool, 0644);
+MODULE_PARM_DESC(transparent, "Enable transparent VLAN forwarding");
+
+/*
+ * The RTL8367D CPU uplink can receive the upstream DHCP reply with a
+ * switch-generated 802.1Q VID that is not present in the user-port
+ * membership bitmap. Keep ingress filtering opt-in for compatibility with
+ * existing RTL8367S boards; a board needing the stricter behavior can opt in
+ * through the realtek,rtl8367d-ingress-filter device-tree property.
+ */
+static bool rtl8367s_8021q_ingress_filter;
+module_param_named(ingress_filter, rtl8367s_8021q_ingress_filter, bool, 0644);
+MODULE_PARM_DESC(ingress_filter, "Enable VLAN ingress membership filtering");
+static bool rtl8367s_8021q_wan_ingress_filter = true;
+module_param_named(wan_ingress_filter, rtl8367s_8021q_wan_ingress_filter, bool, 0644);
+MODULE_PARM_DESC(wan_ingress_filter, "Enable VLAN ingress filtering on the WAN port");
+
+static int rtl8367s_8021q_egress_mode;
+module_param_named(egress_mode, rtl8367s_8021q_egress_mode, int, 0644);
+MODULE_PARM_DESC(egress_mode, "RTL8367D VLAN egress mode (0..3)");
+
+int rtl8367s_vlan_port_set_direct_pvid(struct realtek_priv *priv,
+						      int port, u16 vid);
+static int rtl8367d_load_nctrl_firmware(struct realtek_priv *priv);
 
 /* External interface force configuration registers 0~2 */
 #define RTL8365MB_DIGITAL_INTERFACE_FORCE_REG0		0x1310 /* EXT0 */
@@ -652,6 +690,19 @@ static const struct rtl8365mb_chip_info rtl8365mb_chip_infos[] = {
 		.jam_table = rtl8365mb_init_jam_8365mb_vc,
 		.jam_size = ARRAY_SIZE(rtl8365mb_init_jam_8365mb_vc),
 	},
+	{
+		.name = "RTL8367S-VB",
+		.chip_id = RTL8367S_VB_CHIP_ID,
+		.chip_ver = RTL8367S_VB_CHIP_VER,
+		.extints = {
+			/* The MR80X CPU MAC6 is wired to RTL8367D EXT1. */
+			{ 6, 1, PHY_INTF(SGMII) | PHY_INTF(HSGMII) },
+			{ 7, 2, PHY_INTF(MII) | PHY_INTF(TMII) |
+				PHY_INTF(RMII) | PHY_INTF(RGMII) },
+		},
+		.jam_table = rtl8365mb_init_jam_8365mb_vc,
+		.jam_size = ARRAY_SIZE(rtl8365mb_init_jam_8365mb_vc),
+	},
 };
 
 enum rtl8365mb_stp_state {
@@ -738,6 +789,12 @@ struct rtl8365mb {
 	int irq;
 	const struct rtl8365mb_chip_info *chip_info;
 	struct rtl8365mb_cpu cpu;
+	bool rtl8367d_cpu_aware;
+	bool rtl8367d_transparent;
+	bool rtl8367d_ingress_filter;
+	bool rtl8367d_wan_ingress_filter;
+	u8 rtl8367d_egress_mode;
+	u8 rtl8367d_wan_port;
 	struct mutex mib_lock;
 	struct rtl8365mb_port ports[RTL8365MB_MAX_NUM_PORTS];
 };
@@ -943,6 +1000,27 @@ rtl8365mb_get_port_extint(struct realtek_priv *priv, int port)
 	return NULL;
 }
 
+static bool rtl8367s_vb_use_8021q_tagging(struct realtek_priv *priv)
+{
+	struct rtl8365mb *mb = priv->chip_data;
+
+	if (!mb || !mb->chip_info)
+		return false;
+
+	return mb->chip_info->chip_id == RTL8367S_VB_CHIP_ID &&
+	       mb->chip_info->chip_ver == RTL8367S_VB_CHIP_VER &&
+	       device_property_present(priv->dev,
+				       "realtek,rtl8367d-8021q-tagging");
+}
+
+bool rtl8367s_vb_uses_rtl8367d_vlan(struct realtek_priv *priv)
+{
+	return rtl8367s_vb_use_8021q_tagging(priv);
+}
+
+static void rtl8365mb_port_stp_state_set(struct dsa_switch *ds, int port,
+					 u8 state);
+
 static enum dsa_tag_protocol
 rtl8365mb_get_tag_protocol(struct dsa_switch *ds, int port,
 			   enum dsa_tag_protocol mp)
@@ -954,6 +1032,9 @@ rtl8365mb_get_tag_protocol(struct dsa_switch *ds, int port,
 	mb = priv->chip_data;
 	cpu = &mb->cpu;
 
+	if (rtl8367s_vb_use_8021q_tagging(priv))
+		return DSA_TAG_PROTO_VSC73XX_8021Q;
+
 	if (cpu->position == RTL8365MB_CPU_POS_BEFORE_CRC)
 		return DSA_TAG_PROTO_RTL8_4T;
 
@@ -1042,12 +1123,151 @@ static int rtl8365mb_ext_config_rgmii(struct realtek_priv *priv, int port,
 	return 0;
 }
 
+static int rtl8365mb_ext_config_hsgmii(struct realtek_priv *priv, int port);
+
+static int rtl8365mb_ext_config_sgmii(struct realtek_priv *priv, int port)
+{
+	static const u16 rtl8367d_hsgmii_cfg[][2] = {
+		{ 0x0427, 0x4e0c }, { 0x0428, 0xaa00 },
+		{ 0x0425, 0x5189 }, { 0x0424, 0x8414 },
+		{ 0x0423, 0x1020 }, { 0x0410, 0x0002 },
+		{ 0x0504, 0x051b }, { 0x0421, 0x8e13 },
+		{ 0x0422, 0x1140 }, { 0x0004, 0x074f },
+	};
+	const struct rtl8365mb_extint *extint =
+		rtl8365mb_get_port_extint(priv, port);
+	struct rtl8365mb *mb = priv->chip_data;
+	int ret;
+	int i;
+
+	if (!extint)
+		return -ENODEV;
+
+	if (mb->chip_info->chip_id == RTL8367S_VB_CHIP_ID) {
+		for (i = 0; i < ARRAY_SIZE(rtl8367d_hsgmii_cfg); i++) {
+			ret = regmap_write(priv->map, 0x6602,
+					   rtl8367d_hsgmii_cfg[i][1]);
+			if (ret)
+				return ret;
+
+			ret = regmap_write(priv->map, 0x6601,
+					   rtl8367d_hsgmii_cfg[i][0]);
+			if (ret)
+				return ret;
+
+			ret = regmap_write(priv->map, 0x6600, 0x00cd);
+			if (ret)
+				return ret;
+		}
+
+		ret = regmap_update_bits(priv->map, 0x1d11, BIT(9), BIT(9));
+		if (ret)
+			return ret;
+
+		ret = regmap_update_bits(priv->map, 0x13e8,
+					 GENMASK(7, 6), BIT(6));
+		if (ret)
+			return ret;
+
+		ret = regmap_update_bits(priv->map, 0x1d11,
+					 BIT(10) | BIT(11), BIT(10) | BIT(11));
+		if (ret)
+			return ret;
+
+		dev_info(priv->dev,
+			 "RTL8367S-VB: RTL8367D HSGMII SerDes configured\n");
+
+		return regmap_update_bits(priv->map, 0x1d11,
+					  GENMASK(4, 0), 0x12);
+	}
+
+	ret = regmap_update_bits(
+		priv->map, RTL8365MB_DIGITAL_INTERFACE_SELECT_REG(extint->id),
+		RTL8365MB_DIGITAL_INTERFACE_SELECT_MODE_MASK(extint->id),
+		RTL8365MB_EXT_PORT_MODE_SGMII
+			<< RTL8365MB_DIGITAL_INTERFACE_SELECT_MODE_OFFSET(
+				   extint->id));
+
+	return ret;
+}
+
+static int rtl8365mb_ext_config_hsgmii(struct realtek_priv *priv, int port)
+{
+	const struct rtl8365mb_extint *extint =
+		rtl8365mb_get_port_extint(priv, port);
+	int ret;
+
+	if (!extint)
+		return -ENODEV;
+
+	ret = regmap_update_bits(
+		priv->map, RTL8365MB_DIGITAL_INTERFACE_SELECT_REG(extint->id),
+		RTL8365MB_DIGITAL_INTERFACE_SELECT_MODE_MASK(extint->id),
+		RTL8365MB_EXT_PORT_MODE_HSGMII
+			<< RTL8365MB_DIGITAL_INTERFACE_SELECT_MODE_OFFSET(
+				   extint->id));
+	if (ret)
+		return ret;
+
+	if (port != 6)
+		return 0;
+
+	ret = regmap_update_bits(priv->map, 0x1305, 0x00f0, 0);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, 0x03f7, BIT(1), 0);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, 0x1d41, BIT(5) | BIT(7), 0);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, 0x1d95, BIT(0) | BIT(1), 0);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, 0x1d11, BIT(6) | BIT(9), 0);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, 0x1d11, BIT(11), BIT(11));
+	if (ret)
+		return ret;
+
+	ret = regmap_write(priv->map, 0x00d0, 0x0007);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(priv->map, 0x0399, 0x0007);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(priv->map, 0x03fa, 0x0007);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, 0x1d95, BIT(13), BIT(13));
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, 0x1d95, 0x1f00, 0x12 << 8);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, 0x1d95, BIT(2), 0);
+
+	return ret;
+}
+
 static int rtl8365mb_ext_config_forcemode(struct realtek_priv *priv, int port,
 					  bool link, int speed, int duplex,
 					  bool tx_pause, bool rx_pause)
 {
 	const struct rtl8365mb_extint *extint =
 		rtl8365mb_get_port_extint(priv, port);
+	struct rtl8365mb *mb = priv->chip_data;
 	u32 r_tx_pause;
 	u32 r_rx_pause;
 	u32 r_duplex;
@@ -1059,13 +1279,43 @@ static int rtl8365mb_ext_config_forcemode(struct realtek_priv *priv, int port,
 	if (!extint)
 		return -ENODEV;
 
+	if (mb->chip_info->chip_id == RTL8367S_VB_CHIP_ID && port == 6) {
+		u32 ability = link ? 0x1075 : 0;
+		u32 ability_rb;
+		u32 force_rb;
+
+		/* RTL8367D MAC6 uses dedicated force-ability registers. */
+		ret = regmap_write(priv->map, 0x12c6, ability & ~BIT(4));
+		if (ret)
+			return ret;
+
+		ret = regmap_write(priv->map, 0x12ce, link ? 0xffff : 0);
+		if (ret)
+			return ret;
+
+		ret = regmap_write(priv->map, 0x12c6, ability);
+		if (ret)
+			return ret;
+
+		regmap_read(priv->map, 0x12c6, &ability_rb);
+		regmap_read(priv->map, 0x12ce, &force_rb);
+		dev_info(priv->dev,
+			 "RTL8367S-VB: RTL8367D MAC6 force ability=0x%04x enable=0x%04x\n",
+			 ability_rb, force_rb);
+
+		return 0;
+	}
+
 	if (link) {
 		/* Force the link up with the desired configuration */
 		r_link = 1;
 		r_rx_pause = rx_pause ? 1 : 0;
 		r_tx_pause = tx_pause ? 1 : 0;
 
-		if (speed == SPEED_1000) {
+		if (speed == SPEED_2500 &&
+		    rtl8367s_vb_use_8021q_tagging(priv)) {
+			r_speed = RTL8365MB_PORT_SPEED_2500M;
+		} else if (speed == SPEED_1000) {
 			r_speed = RTL8365MB_PORT_SPEED_1000M;
 		} else if (speed == SPEED_100) {
 			r_speed = RTL8365MB_PORT_SPEED_100M;
@@ -1122,6 +1372,10 @@ static void rtl8365mb_phylink_get_caps(struct dsa_switch *ds, int port,
 	config->mac_capabilities = MAC_SYM_PAUSE | MAC_ASYM_PAUSE |
 				   MAC_10 | MAC_100 | MAC_1000FD;
 
+	if (rtl8367s_vb_use_8021q_tagging(ds->priv) && extint &&
+	    extint->supported_interfaces & RTL8365MB_PHY_INTERFACE_MODE_HSGMII)
+		config->mac_capabilities |= MAC_2500FD;
+
 	if (!extint) {
 		__set_bit(PHY_INTERFACE_MODE_INTERNAL,
 			  config->supported_interfaces);
@@ -1141,6 +1395,13 @@ static void rtl8365mb_phylink_get_caps(struct dsa_switch *ds, int port,
 
 	if (extint->supported_interfaces & RTL8365MB_PHY_INTERFACE_MODE_RGMII)
 		phy_interface_set_rgmii(config->supported_interfaces);
+
+	if (extint->supported_interfaces & RTL8365MB_PHY_INTERFACE_MODE_SGMII)
+		__set_bit(PHY_INTERFACE_MODE_SGMII, config->supported_interfaces);
+
+	if (extint->supported_interfaces & RTL8365MB_PHY_INTERFACE_MODE_HSGMII)
+		__set_bit(PHY_INTERFACE_MODE_2500BASEX,
+			  config->supported_interfaces);
 }
 
 static void rtl8365mb_phylink_mac_config(struct phylink_config *config,
@@ -1168,6 +1429,26 @@ static void rtl8365mb_phylink_mac_config(struct phylink_config *config,
 		return;
 	}
 
+	if (state->interface == PHY_INTERFACE_MODE_SGMII) {
+		ret = rtl8365mb_ext_config_sgmii(priv, port);
+		if (ret)
+			dev_err(priv->dev,
+				"failed to configure SGMII mode on port %d: %pe\n",
+				port, ERR_PTR(ret));
+
+		return;
+	}
+
+	if (state->interface == PHY_INTERFACE_MODE_2500BASEX) {
+		ret = rtl8365mb_ext_config_hsgmii(priv, port);
+		if (ret)
+			dev_err(priv->dev,
+				"failed to configure HSGMII mode on port %d: %pe\n",
+				port, ERR_PTR(ret));
+
+		return;
+	}
+
 	/* TODO: Implement MII and RMII modes, which the RTL8365MB-VC also
 	 * supports
 	 */
@@ -1188,7 +1469,14 @@ static void rtl8365mb_phylink_mac_link_down(struct phylink_config *config,
 	p = &mb->ports[port];
 	cancel_delayed_work_sync(&p->mib_work);
 
-	if (phy_interface_mode_is_rgmii(interface)) {
+	if (phy_interface_mode_is_rgmii(interface) ||
+	    interface == PHY_INTERFACE_MODE_SGMII ||
+	    interface == PHY_INTERFACE_MODE_2500BASEX) {
+		if (rtl8367s_vb_use_8021q_tagging(priv) &&
+		    (dsa_port_is_cpu(dp) || !dsa_port_bridge_dev_get(dp)))
+			rtl8365mb_port_stp_state_set(dp->ds, port,
+						     BR_STATE_DISABLED);
+
 		ret = rtl8365mb_ext_config_forcemode(priv, port, false, 0, 0,
 						     false, false);
 		if (ret)
@@ -1218,7 +1506,9 @@ static void rtl8365mb_phylink_mac_link_up(struct phylink_config *config,
 	p = &mb->ports[port];
 	schedule_delayed_work(&p->mib_work, 0);
 
-	if (phy_interface_mode_is_rgmii(interface)) {
+	if (phy_interface_mode_is_rgmii(interface) ||
+	    interface == PHY_INTERFACE_MODE_SGMII ||
+	    interface == PHY_INTERFACE_MODE_2500BASEX) {
 		ret = rtl8365mb_ext_config_forcemode(priv, port, true, speed,
 						     duplex, tx_pause,
 						     rx_pause);
@@ -1227,6 +1517,11 @@ static void rtl8365mb_phylink_mac_link_up(struct phylink_config *config,
 				"failed to force mode on port %d: %pe\n", port,
 				ERR_PTR(ret));
 
+		if (rtl8367s_vb_use_8021q_tagging(priv) &&
+		    (dsa_port_is_cpu(dp) || !dsa_port_bridge_dev_get(dp)))
+			rtl8365mb_port_stp_state_set(dp->ds, port,
+						     BR_STATE_FORWARDING);
+
 		return;
 	}
 }
@@ -1343,6 +1638,12 @@ static int rtl8365mb_port_vlan_filtering(struct dsa_switch *ds, int port,
 	enum rtl8365mb_frame_ingress accepted_frame, prev_accepted_frame;
 	enum rtl8365mb_vlan_egress_mode mode;
 	struct realtek_priv *priv = ds->priv;
+	struct rtl8365mb *mb = priv->chip_data;
+	bool ingress_filtering = vlan_filtering;
+	bool old_ingress_filtering = !vlan_filtering;
+	bool transparent = !vlan_filtering;
+	bool old_transparent = vlan_filtering;
+	bool use_8021q;
 	u32 configured_ports = 0;
 	struct dsa_port *dp;
 	u16 pvid_vid;
@@ -1377,7 +1678,27 @@ static int rtl8365mb_port_vlan_filtering(struct dsa_switch *ds, int port,
 	 * called for all member ports. We need to enable/disable ingress
 	 * VLAN membership check.
 	 */
-	ret = rtl8365mb_port_set_ingress_filtering(priv, port, vlan_filtering);
+	use_8021q = rtl8367s_vb_use_8021q_tagging(priv);
+	if (use_8021q) {
+		bool fallback_ingress = mb->rtl8367d_ingress_filter;
+
+		if (ds->tag_8021q_vlan_upper_rx)
+			fallback_ingress = false;
+		else if (port == mb->rtl8367d_wan_port &&
+		    !mb->rtl8367d_wan_ingress_filter)
+			fallback_ingress = false;
+
+		if (vlan_filtering) {
+			old_ingress_filtering = fallback_ingress;
+			old_transparent = mb->rtl8367d_transparent;
+		} else {
+			ingress_filtering = fallback_ingress;
+			transparent = mb->rtl8367d_transparent;
+		}
+	}
+
+	ret = rtl8365mb_port_set_ingress_filtering(priv, port,
+						   ingress_filtering);
 	if (ret)
