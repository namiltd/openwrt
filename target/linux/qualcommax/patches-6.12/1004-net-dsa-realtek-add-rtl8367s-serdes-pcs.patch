 #define RTL8367D_NCTRL_SIZE				1545
 #define RTL8367D_NCTRL_BASE				0xe000
@@ -602,6 +699,48 @@ static const struct rtl8365mb_jam_tbl_entry rtl8365mb_init_jam_common[] = {
