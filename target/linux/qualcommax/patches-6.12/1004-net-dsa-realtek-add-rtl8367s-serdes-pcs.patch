+#define RTL8367D_SDS_MISC_PA12PC_EN			BIT(10)
+#define RTL8367D_SDS_MISC_MAC6_SEL_SDS0			BIT(9)
+#define RTL8367D_SDS_MISC_MODE_MASK			GENMASK(4, 0)
+#define RTL8367D_SDS_MISC_MODE_SGMII			0x02
+#define RTL8367D_SDS_MISC_MODE_HSGMII			0x12
