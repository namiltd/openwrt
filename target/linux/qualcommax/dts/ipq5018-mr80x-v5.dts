/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Mercusys MR80X v5";
	compatible = "mercusys,mr80x-v5", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;
		led-boot = &led_status_green;
		led-failsafe = &led_status_orange;
		led-running = &led_status_green;
		led-upgrade = &led_status_green;
		label-mac-device = &lan1_port;
	};

	chosen {
		bootargs-append = " root=/dev/ubiblock0_1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 14 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&tlmm 16 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_status_green: status-green {
			gpios = <&tlmm 13 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			default-state = "on";
		};

		led_status_orange: status-orange {
			gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_ORANGE>;
			function = LED_FUNCTION_STATUS;
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:sbl1";
				reg = <0x00000000 0x00080000>;
				read-only;
			};

			partition@80000 {
				label = "0:mibib";
				reg = <0x00080000 0x00080000>;
				read-only;
			};

			partition@100000 {
				label = "0:bootconfig";
				reg = <0x00100000 0x00040000>;
				read-only;
			};

			partition@140000 {
				label = "0:bootconfig1";
				reg = <0x00140000 0x00040000>;
				read-only;
			};

			partition@180000 {
				label = "0:qsee";
				reg = <0x00180000 0x00100000>;
				read-only;
			};

			partition@280000 {
				label = "0:devcfg";
				reg = <0x00280000 0x00040000>;
				read-only;
			};

			partition@2c0000 {
				label = "0:cdt";
				reg = <0x002c0000 0x00040000>;
				read-only;
			};

			partition@300000 {
				compatible = "u-boot,env";
				label = "0:appsblenv";
				reg = <0x00300000 0x00080000>;
				env-size = <0x40000>;
			};

			partition@380000 {
				label = "0:appsbl";
				reg = <0x00380000 0x00140000>;
				read-only;
			};

			partition_0_art: partition@4c0000 {
				label = "0:art";
				reg = <0x004c0000 0x00100000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					cal_art_1000: calibration@1000 {
						reg = <0x1000 0x20000>;
						#nvmem-cell-cells = <0>;
					};

					cal_art_26800: calibration@26800 {
						reg = <0x26800 0x20000>;
						#nvmem-cell-cells = <0>;
					};
				};
			};

			partition@5c0000 {
				label = "0:training";
				reg = <0x005c0000 0x00080000>;
				read-only;
			};

			partition@640000 {
				label = "rootfs";
				reg = <0x00640000 0x02a00000>;
			};

			partition@3040000 {
				label = "rootfs_1";
				reg = <0x03040000 0x02a00000>;
			};

			partition_tp_data: partition@5a40000 {
				label = "tp-data";
				reg = <0x05a40000 0x00840000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_tp_data_2d5030: macaddr@2d5030 {
						compatible = "mac-base";
						reg = <0x2d5030 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@6280000 {
				label = "radio";
				reg = <0x06280000 0x00440000>;
			};

			partition@66c0000 {
				label = "data";
				reg = <0x066c0000 0x00080000>;
			};
		};
	};
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
};

&gmac1 {
	status = "okay";

	phy-mode = "2500base-x";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_tp_data_2d5030 (-1)>;

	fixed-link {
		speed = <2500>;
		full-duplex;
		pause;
	};
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	switch@29 {
		compatible = "realtek,rtl8365mb";
		reg = <29>;
		reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
		/* MR80X uses the RTL8367D 802.1Q CPU path for both native WAN
		 * traffic and VLAN upper compatibility. Keep these quirks local
		 * to this board; other rtl8365mb users retain the default path. */
		realtek,rtl8367d-8021q-tagging;
		realtek,rtl8367d-cpu-aware;
		realtek,rtl8367d-ingress-filter;
		realtek,rtl8367d-wan-port = <0>;
		realtek,rtl8367d-standalone-vlan-uppers;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "wan";
				phy-handle = <&rtl8367s_phy0>;
				nvmem-cell-names = "mac-address";
				nvmem-cells = <&macaddr_tp_data_2d5030 1>;
			};

			lan1_port: port@1 {
				reg = <1>;
				label = "lan1";
				phy-handle = <&rtl8367s_phy1>;
				nvmem-cell-names = "mac-address";
				nvmem-cells = <&macaddr_tp_data_2d5030 0>;
			};

			port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&rtl8367s_phy2>;
				nvmem-cell-names = "mac-address";
				nvmem-cells = <&macaddr_tp_data_2d5030 2>;
			};

			port@3 {
				reg = <3>;
				label = "lan3";
				phy-handle = <&rtl8367s_phy3>;
				nvmem-cell-names = "mac-address";
				nvmem-cells = <&macaddr_tp_data_2d5030 3>;
			};

			port@6 {
				reg = <6>;
				label = "cpu";
				ethernet = <&gmac1>;
				phy-mode = "2500base-x";
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <2500>;
					full-duplex;
					pause;
				};
			};
		};

		mdio {
			compatible = "realtek,smi-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			rtl8367s_phy0: ethernet-phy@0 {
				reg = <0>;
			};

			rtl8367s_phy1: ethernet-phy@1 {
				reg = <1>;
			};

			rtl8367s_phy2: ethernet-phy@2 {
				reg = <2>;
			};

			rtl8367s_phy3: ethernet-phy@3 {
				reg = <3>;
			};
		};
	};
};

&tlmm {
	phy_reset_hog: phy-reset-hog {
		gpio-hog;
		gpios = <26 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "phy-reset-gpio";
	};

	button_pins: button-state {
		pins = "gpio14", "gpio16";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	led_pins: led-state {
		pins = "gpio12", "gpio13";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};
};

&q6_region {
	reg = <0x0 0x4b000000 0x0 0x2e00000>;
};

&q6v5_wcss {
	status = "okay";

	boot-args = <0x1 4 3 15 0 0 0x2 4 2 27 0 0>;
};

&wifi {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd1>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
	qcom,ath11k-calibration-variant = "Mercusys-MR80X-v5";
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,ath11k-low-memory-datapath;
	qcom,ath11k-calibration-needs-macflag;
	qcom,bdf-addr = <0x4c400000>;
	nvmem-cell-names = "mac-address", "calibration";
	nvmem-cells = <&macaddr_tp_data_2d5030 4>, <&cal_art_1000>;
};

&wifi1 {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "Mercusys-MR80X-v5";
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,ath11k-low-memory-datapath;
	qcom,ath11k-calibration-needs-macflag;
	qcom,bdf-addr = <0x4d100000>;
	nvmem-cell-names = "mac-address", "calibration";
	nvmem-cells = <&macaddr_tp_data_2d5030 5>, <&cal_art_26800>;
};
