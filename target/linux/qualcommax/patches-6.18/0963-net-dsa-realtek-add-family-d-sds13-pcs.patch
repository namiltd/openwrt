From: Fabiano Tassotti <fabianotassotti@gmail.com>
Subject: [PATCH] net: dsa: realtek: add family D SDS13 PCS support

Extend the existing RTL8367S SGMII/HSGMII PCS implementation in this
driver for family D switches, whose CPU SerDes is reached through the
indexed SDS13 window and whose SDS_MISC fields differ from family C.

The register sequence and tuning tables are derived from the GPL-licensed
Realtek RTL8367D port API distributed in the Mercusys MR80X GPL release.
Keep the existing family C path unchanged and select the new behavior from
the driver's chip-family metadata, making the implementation reusable by
other family D boards.

Signed-off-by: Fabiano Tassotti <fabianotassotti@gmail.com>
---
--- a/drivers/net/dsa/realtek/rtl8365mb_main.c
+++ b/drivers/net/dsa/realtek/rtl8365mb_main.c
@@ -269,6 +269,7 @@
 #define   RTL8365MB_SDS_INDACS_CMD_BUSY_MASK	0x0100
 #define   RTL8365MB_SDS_INDACS_CMD_RUN_MASK	0x0080
 #define   RTL8365MB_SDS_INDACS_CMD_WR_MASK	0x0040
+#define   RTL8365MB_SDS_INDACS_CMD_INDEX_MASK	GENMASK(5, 0)
 #define RTL8365MB_SDS_INDACS_ADR_REG		0x6601
 #define RTL8365MB_SDS_INDACS_DATA_REG		0x6602
 
@@ -317,6 +318,18 @@
 #define   RTL8365MB_SDS_OPTION_ARM_KEY		0x0249
 #define RTL8365MB_SDS_OPTION_REG		0x13C1
 
+/* Family D uses the SDS13 indirect window for its MAC6 SerDes. */
+#define RTL8367D_SDS_EXT0_INDEX			13
+#define RTL8367D_FIBER_CFG2_REG			0x13E8
+#define   RTL8367D_FIBER_CFG2_RX_DISABLE_MASK	GENMASK(7, 6)
+#define   RTL8367D_FIBER_CFG2_RX_DISABLE_SDS0	BIT(6)
+#define RTL8367D_SDS_MISC_PA33PC_EN		BIT(11)
+#define RTL8367D_SDS_MISC_PA12PC_EN		BIT(10)
+#define RTL8367D_SDS_MISC_MAC6_SEL_SDS0		BIT(9)
+#define RTL8367D_SDS_MISC_MODE_MASK		GENMASK(4, 0)
+#define RTL8367D_SDS_MISC_MODE_SGMII		0x02
+#define RTL8367D_SDS_MISC_MODE_HSGMII		0x12
+
 /* Embedded DW8051 microcontroller control registers. The microcontroller
  * can run firmware to manage the SerDes link, but this driver keeps it in
  * reset and disabled: phylink already performs the link management that
@@ -690,6 +703,21 @@
 	{ 0x0424, 0xD810 }, { 0x0001, 0x0F80 }, { 0x002E, 0x83F2 },
 };
 
+/* Family D tuning tables from the Realtek vendor port API. */
+static const struct rtl8365mb_jam_tbl_entry rtl8367d_sds_jam_sgmii[] = {
+	{ 0x0427, 0x4E0C }, { 0x0428, 0xAA00 }, { 0x0425, 0x5189 },
+	{ 0x0424, 0x8414 }, { 0x0423, 0x1020 }, { 0x0410, 0x0002 },
+	{ 0x0484, 0x011B }, { 0x0421, 0x8E13 }, { 0x0422, 0x1140 },
+	{ 0x0004, 0x074F },
+};
+
+static const struct rtl8365mb_jam_tbl_entry rtl8367d_sds_jam_hsgmii[] = {
+	{ 0x0427, 0x4E0C }, { 0x0428, 0xAA00 }, { 0x0425, 0x5189 },
+	{ 0x0424, 0x8414 }, { 0x0423, 0x1020 }, { 0x0410, 0x0002 },
+	{ 0x0504, 0x051B }, { 0x0421, 0x8E13 }, { 0x0422, 0x1140 },
+	{ 0x0004, 0x074F },
+};
+
 enum rtl8365mb_phy_interface_mode {
 	RTL8365MB_PHY_INTERFACE_MODE_INVAL = 0,
 	RTL8365MB_PHY_INTERFACE_MODE_INTERNAL = BIT(0),
@@ -1239,7 +1267,8 @@
 	return 0;
 }
 
-static int rtl8365mb_sds_write(struct realtek_priv *priv, u16 addr, u16 data)
+static int rtl8365mb_sds_write_index(struct realtek_priv *priv, u8 index,
+				     u16 addr, u16 data)
 {
 	int ret;
 
@@ -1257,10 +1286,18 @@
 	 */
 	return regmap_write(priv->map, RTL8365MB_SDS_INDACS_CMD_REG,
 			    RTL8365MB_SDS_INDACS_CMD_RUN_MASK |
-			    RTL8365MB_SDS_INDACS_CMD_WR_MASK);
+			    RTL8365MB_SDS_INDACS_CMD_WR_MASK |
+			    FIELD_PREP(RTL8365MB_SDS_INDACS_CMD_INDEX_MASK,
+				       index));
 }
 
-static int rtl8365mb_sds_read(struct realtek_priv *priv, u16 addr, u16 *data)
+static int rtl8365mb_sds_write(struct realtek_priv *priv, u16 addr, u16 data)
+{
+	return rtl8365mb_sds_write_index(priv, 0, addr, data);
+}
+
+static int rtl8365mb_sds_read_index(struct realtek_priv *priv, u8 index,
+				    u16 addr, u16 *data)
 {
 	u32 val;
 	int ret;
@@ -1270,7 +1307,9 @@
 		return ret;
 
 	ret = regmap_write(priv->map, RTL8365MB_SDS_INDACS_CMD_REG,
-			   RTL8365MB_SDS_INDACS_CMD_RUN_MASK);
+			   RTL8365MB_SDS_INDACS_CMD_RUN_MASK |
+			   FIELD_PREP(RTL8365MB_SDS_INDACS_CMD_INDEX_MASK,
+				      index));
 	if (ret)
 		return ret;
 
@@ -1293,6 +1332,11 @@
 	return 0;
 }
 
+static int rtl8365mb_sds_read(struct realtek_priv *priv, u16 addr, u16 *data)
+{
+	return rtl8365mb_sds_read_index(priv, 0, addr, data);
+}
+
 /* The vendor driver selects between two sets of SerDes tuning parameters based
  * on the chip option register. Only the variant for a non-zero option has been
  * tested on real hardware - the RTL8367S parts seen so far all report 1. The
@@ -1310,6 +1354,14 @@
 	int ret;
 	int i;
 
+	/* Family D has a fixed SDS13 programming model and does not use the
+	 * family C option register to select its tuning table.
+	 */
+	if (rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_D) {
+		mb->sds_supported = true;
+		return 0;
+	}
+
 	/* Nothing to probe if no external interface is wired to the SerDes */
 	for (i = 0; i < RTL8365MB_MAX_NUM_EXTINTS; i++) {
 		extint = &mb->chip_info->extints[i];
@@ -1346,6 +1398,57 @@
 	return 0;
 }
 
+static int rtl8367d_pcs_config(struct realtek_priv *priv,
+			       phy_interface_t interface)
+{
+	const struct rtl8365mb_jam_tbl_entry *sds_jam;
+	size_t sds_jam_size;
+	u32 mode;
+	int ret;
+	int i;
+
+	if (interface == PHY_INTERFACE_MODE_2500BASEX) {
+		sds_jam = rtl8367d_sds_jam_hsgmii;
+		sds_jam_size = ARRAY_SIZE(rtl8367d_sds_jam_hsgmii);
+		mode = RTL8367D_SDS_MISC_MODE_HSGMII;
+	} else {
+		sds_jam = rtl8367d_sds_jam_sgmii;
+		sds_jam_size = ARRAY_SIZE(rtl8367d_sds_jam_sgmii);
+		mode = RTL8367D_SDS_MISC_MODE_SGMII;
+	}
+
+	ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
+				 RTL8367D_SDS_MISC_MAC6_SEL_SDS0,
+				 RTL8367D_SDS_MISC_MAC6_SEL_SDS0);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < sds_jam_size; i++) {
+		ret = rtl8365mb_sds_write_index(priv, RTL8367D_SDS_EXT0_INDEX,
+						sds_jam[i].reg, sds_jam[i].val);
+		if (ret)
+			return ret;
+	}
+
+	ret = regmap_update_bits(priv->map, RTL8367D_FIBER_CFG2_REG,
+				 RTL8367D_FIBER_CFG2_RX_DISABLE_MASK,
+				 RTL8367D_FIBER_CFG2_RX_DISABLE_SDS0);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->map, RTL8365MB_SDS_MISC_REG,
+				 RTL8367D_SDS_MISC_PA33PC_EN |
+				 RTL8367D_SDS_MISC_PA12PC_EN |
+				 RTL8367D_SDS_MISC_MODE_MASK,
+				 RTL8367D_SDS_MISC_PA33PC_EN |
+				 RTL8367D_SDS_MISC_PA12PC_EN | mode);
+	if (!ret)
+		dev_info(priv->dev, "family D SerDes %s configured on SDS%u\n",
+			 phy_modes(interface), RTL8367D_SDS_EXT0_INDEX);
+
+	return ret;
+}
+
 /* The vendor driver raises the port 6 ingress and egress rate limiters to
  * their maximum in its switch init, unconditionally for the whole chip
  * family. The chip reset in rtl8365mb_setup() puts them back to their reset
@@ -1436,6 +1539,9 @@
 	if (ret)
 		return ret;
 
+	if (rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_D)
+		return rtl8367d_pcs_config(priv, interface);
+
 	/* Tune the SerDes with vendor-prescribed parameters */
 	for (i = 0; i < sds_jam_size; i++) {
 		ret = rtl8365mb_sds_write(priv, sds_jam[i].reg,
@@ -1520,6 +1626,7 @@
 	struct rtl8365mb *mb = pcs_to_rtl8365mb(pcs);
 	struct realtek_priv *priv = mb->priv;
 	u16 status;
+	u8 sds_index = 0;
 	u32 val;
 	int ret;
 
@@ -1530,7 +1637,11 @@
 	 * rtl8365mb_pcs_config()), so the link status register can be read
 	 * directly through the SDS_INDACS window without racing the auto-poll.
 	 */
-	ret = rtl8365mb_sds_read(priv, RTL8365MB_SDS_REG_LINK_STATUS, &status);
+	if (rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_D)
+		sds_index = RTL8367D_SDS_EXT0_INDEX;
+
+	ret = rtl8365mb_sds_read_index(priv, sds_index,
+				       RTL8365MB_SDS_REG_LINK_STATUS, &status);
 	if (ret) {
 		state->link = false;
 		return;
@@ -1541,6 +1652,13 @@
 	if (!state->link)
 		return;
 
+	if (rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_D) {
+		state->duplex = DUPLEX_FULL;
+		state->speed = state->interface == PHY_INTERFACE_MODE_2500BASEX ?
+				SPEED_2500 : SPEED_1000;
+		return;
+	}
+
 	/* The speed and duplex are forced; read them back from the values
 	 * programmed into the SerDes MISC register.
 	 */
@@ -1582,6 +1700,12 @@
 	u32 r_speed;
 	int ret;
 
+	/* Family D forces the external MAC ability from mac_link_up(); its
+	 * SDS_MISC fields do not share the family C link-force layout.
+	 */
+	if (rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_D)
+		return;
+
 	/* The speed field has no value for 2.5 Gbps: the rate is determined by
 	 * the HSGMII SerDes configuration, and the vendor driver programs the
 	 * 1 Gbps value here.
@@ -1896,7 +2020,8 @@
 		 * rtl8365mb_pcs_link_up() because pcs_link_up() carries no
 		 * pause information.
 		 */
-		if (rtl8365mb_interface_is_serdes(interface)) {
+		if (rtl8365mb_interface_is_serdes(interface) &&
+		    rtl8365mb_get_family(priv) == RTL8365MB_FAMILY_C) {
 			u32 val = 0;
 
 			if (tx_pause)
