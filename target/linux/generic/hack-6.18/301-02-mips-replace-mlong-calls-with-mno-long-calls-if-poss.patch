--- a/arch/mips/kernel/module.c
+++ b/arch/mips/kernel/module.c
@@ -8,6 +8,7 @@
 
 #undef DEBUG
 
+#include <linux/execmem.h>
 #include <linux/extable.h>
 #include <linux/moduleloader.h>
 #include <linux/elf.h>
@@ -19,6 +20,9 @@
 #include <linux/kernel.h>
